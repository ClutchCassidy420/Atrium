# Settings for atrium-hostctl (a systemd EnvironmentFile). Copy to /etc/atrium/hostctl.env, mode 600, owned by root.
HOSTCTL_LISTEN=172.20.0.1:8766                 # an address only the web container can reach (for example the Docker bridge address)
HOSTCTL_ALLOWED=172.20.0.50                    # the web container's address; nothing else may call the helper
HOSTCTL_KEY=change-me-to-a-long-random-value   # also goes into the web app's config as HOST_ACTION_KEY
HOSTCTL_APP_CHECK=http://172.20.0.50:8000/api/gate-check   # the web app confirms a person's session cookie (owners only)
HOSTCTL_CARE=docker,containerd                 # package name prefixes that can restart services, grouped apart from the safe updates
HOSTCTL_BACKUP_UNITS=                          # optional: systemd unit names that mean "a backup is running", comma separated
HOSTCTL_COUNTDOWN=30                           # seconds you get to cancel a reboot or shutdown
HOSTCTL_TIER_LOW=                              # container groups (compose project names) that are low risk: the page may update them
HOSTCTL_TIER_MEDIUM=                           # container groups that are medium risk: the page may update them too (anything not listed is high risk and is updated by hand)
HOSTCTL_KEEP_DAYS=7                            # how long the previous build of an updated group is kept for a rollback
HOSTCTL_CHECK_HOURS=6                          # how often to look for newer images
# HOSTCTL_DRYRUN=1                             # test mode: updates are simulated and reboot/shutdown do nothing

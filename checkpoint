#!/usr/bin/env python3
"""Save a stopped source install, or restore it into a new private profile."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


ROOT = Path(__file__).resolve().parents[1]
GENERATED = {"runtime-env", "web-env", "start.lock"}


def private_directory(path):
    stat = path.stat()
    if not path.is_dir() or stat.st_uid != os.getuid() or stat.st_mode & 0o077:
        raise ValueError(f"Expected a private directory owned by this account: {path}")


def publish(source, destination, write, install_root):
    if destination.exists() or destination.is_symlink():
        raise ValueError("Choose a new destination. The specified path already exists.")
    parent = destination.parent.resolve(strict=True)
    if parent.is_relative_to(source) or parent.is_relative_to(install_root):
        raise ValueError("Choose a destination outside the source directory and checkout.")
    if subprocess.run(["git", "-C", str(parent), "rev-parse", "--git-dir"],
                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0:
        raise ValueError("Keep private profile data outside Git checkouts.")
    with tempfile.TemporaryDirectory(prefix=".atrium-copy-", dir=parent) as temp:
        stage = Path(temp) / "profile"
        stage.mkdir(mode=0o700)
        write(stage)
        # mv -nT publishes on this filesystem without replacing a racing destination.
        subprocess.run(["mv", "-nT", "--", stage, destination], check=True)
        if stage.exists():
            raise ValueError("Another operation created the destination.")


def save(profile, destination, release):
    private_directory(profile)
    if profile.is_relative_to(ROOT) or profile.is_relative_to(release):
        raise ValueError("Choose an installed profile outside the checkout.")
    if not (profile / "web-data/users.json").is_file():
        raise ValueError("This profile has no installed user store.")
    with (profile / "start.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if subprocess.check_output(["git", "status", "--porcelain"], cwd=release):
            raise ValueError("Commit source changes before recording the release pin.")
        revision = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=release, text=True).strip()

        def write(stage):
            # Exclude generated entries only at the top level. Preserve nested files and links.
            shutil.copytree(profile, stage / "state", symlinks=True,
                            ignore=lambda path, names: GENERATED if Path(path) == profile else set())
            (stage / "release.json").write_text(json.dumps({"format": 1, "revision": revision}) + "\n")

        publish(profile, destination, write, release)
    print(f"Saved profile for {revision}.")


def restore(snapshot, destination):
    private_directory(snapshot)
    metadata = json.loads((snapshot / "release.json").read_text())
    if metadata.get("format") != 1 or not re.fullmatch("[0-9a-f]{40}", metadata.get("revision", "")):
        raise ValueError("Unrecognized Atrium checkpoint.")
    state = snapshot / "state"
    if state.is_symlink() or not (state / "web-data/users.json").is_file():
        raise ValueError("Checkpoint is missing its profile.")
    publish(snapshot, destination,
            lambda stage: shutil.copytree(state, stage, dirs_exist_ok=True, symlinks=True), ROOT)
    print(f"Restored profile. Start it with release {metadata['revision']}.")


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("save", "restore"))
    parser.add_argument("source", type=Path)
    parser.add_argument("destination", type=Path)
    parser.add_argument("--release", type=Path, help="checkout running the source profile (save only)")
    args = parser.parse_args()
    os.umask(0o077)
    try:
        source, destination = args.source.resolve(strict=True), args.destination.absolute()
        if args.action == "save":
            release = (args.release or ROOT).resolve(strict=True)
            if not (release / "atrium/start").is_file():
                raise ValueError("Select the checkout containing the installed Atrium launcher.")
            save(source, destination, release)
        elif args.release:
            parser.error("--release applies only to save")
        else:
            restore(source, destination)
    except BlockingIOError:
        sys.exit("Stop the running Atrium profile before taking a checkpoint.")
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        sys.exit(str(exc))

# Copy to .env (next to compose.yaml) and fill in only what you use. Everything is optional; the app starts without any of it.
# Never commit .env: it is git-ignored.

# Connect your Hermes agent. On the same computer, use host.docker.internal instead of localhost.
# HERMES_API_BASE=http://host.docker.internal:8642
# HERMES_API_KEY=
# HERMES_DASHBOARD_BASE=http://host.docker.internal:9119

# Port on this computer (default 8000), and who may reach it. Leave the address alone unless you have put HTTPS in front.
# ATRIUM_PORT=8000
# ATRIUM_BIND=127.0.0.1

# More settings (email, files and calendar, push notifications...) are listed in config.private.example.
